# Copy to .env and adjust as needed. Nothing here is required to run the
# application - every value has a safe default and the app is fully
# functional using file upload / paste / sample-dataset ingestion alone.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Authentication (optional, but strongly recommended once deployed) ---
# Leave unset for local single-analyst use - the app runs with no login at
# all (a startup warning is logged either way). Set this before exposing a
# deployment beyond your own machine: every API route (and, functionally,
# the UI) then requires this password to access.
APP_PASSWORD=
# Signs the session cookie issued at login. If left unset, one is generated
# randomly at each server start (sessions then don't survive a restart, but
# nothing is silently insecure). Set a fixed value to keep sessions valid
# across restarts/redeploys.
SESSION_SECRET=

# --- Upload / ingestion limits ---
MAX_UPLOAD_BYTES=26214400
MAX_PASTE_BYTES=10485760
MAX_EVENTS_PER_DATASET=50000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Detection lifecycle persistence ---
# Where the SQLite database backing the detection lifecycle (draft ->
# ... -> approved -> production -> deprecated) is stored. Defaults to
# backend/data/detections.sqlite. Set to ":memory:" for a throwaway DB (this
# is what tests use automatically). Everything else in the app (sessions,
# parsed events, mappings) is still in-memory only - see ARCHITECTURE.md.
DETECTION_DB_PATH=

# --- Detection tuning ---
# Comma-separated CIDR list overriding what the CIDR evaluator (used by the
# "Internal-to-External Traffic Anomaly" detection) treats as "internal".
# Default: RFC1918 + loopback + link-local (IPv4 and IPv6). Example:
# INTERNAL_CIDR_RANGES=10.0.0.0/8,192.168.100.0/24
INTERNAL_CIDR_RANGES=

# --- Elasticsearch (optional direct-fetch integration) ---
# Leave all of these unset to use file upload / paste / sample datasets only.
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=
ELASTICSEARCH_TIMEOUT_MS=15000

# --- AI assist (optional) ---
# Only used for supplementary narrative text (detection explanations, mapping
# guidance, false-positive analysis). All core parsing/ECS/detection/rule/
# statistics logic is deterministic and works identically with all of this
# unset. Instead of env vars, you can also paste a key into the app's
# Settings tab at runtime - that takes priority over whatever is set here for
# the life of the running server process, and is never written to disk.
#
# Set AI_PROVIDER to force which one below is used (anthropic|groq|openai|gemini|custom).
# If unset, the first provider below with a key configured wins.
AI_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (via its OpenAI-compatible endpoint) - has a free tier,
# get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Any other OpenAI-compatible API (OpenRouter, Together, a local Ollama
# OpenAI-shim, etc.) - requires AI_PROVIDER=custom
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# How long to wait for an AI provider response before giving up, and how many
# times to retry a transient failure (network error, timeout, 429, 5xx) with
# backoff. Auth errors (401/403) and other 4xx are never retried.
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
